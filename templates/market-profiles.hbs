<div class="market-forge-profiles-shell">
  <header class="market-forge-profiles-header">
    <div>
      <h2><i class="fa-solid fa-shop"></i> {{localize "PF2E_MARKET_FORGE.Profiles.Title"}}</h2>
      <p>{{localize "PF2E_MARKET_FORGE.Profiles.Intro"}}</p>
    </div>
    <div class="market-forge-profile-editor-actions">
      <button type="button" data-profile-new><i class="fa-solid fa-plus"></i>{{localize "PF2E_MARKET_FORGE.Profiles.New"}}</button>
      <button type="button" data-profile-duplicate><i class="fa-solid fa-copy"></i>{{localize "PF2E_MARKET_FORGE.Profiles.Duplicate"}}</button>
    </div>
  </header>

  <div class="market-forge-profiles-layout">
    <aside class="market-forge-profile-list-panel">
      <label>
        <span>{{localize "PF2E_MARKET_FORGE.Profiles.Profile"}}</span>
        <select data-profile-select>
          {{#each profiles}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}{{#if isDefault}} ★{{/if}}</option>
          {{/each}}
        </select>
      </label>
      <div class="market-forge-profile-id"><span>ID</span><code>{{draft.id}}</code></div>
      {{#if draft.isDefault}}
        <div class="market-forge-info"><i class="fa-solid fa-star"></i>{{localize "PF2E_MARKET_FORGE.Profiles.IsDefault"}}</div>
      {{else}}
        <button type="button" data-profile-default><i class="fa-solid fa-star"></i>{{localize "PF2E_MARKET_FORGE.Profiles.SetDefault"}}</button>
      {{/if}}
      <button type="button" data-profile-delete {{#unless canDelete}}disabled{{/unless}}><i class="fa-solid fa-trash"></i>{{localize "PF2E_MARKET_FORGE.Profiles.Delete"}}</button>
      <p class="notes">{{localize "PF2E_MARKET_FORGE.Profiles.DefaultHint"}}</p>
    </aside>

    <main class="market-forge-profile-editor">
      <section class="market-forge-profile-section">
        <h3>{{localize "PF2E_MARKET_FORGE.Profiles.General"}}</h3>
        <div class="market-forge-profile-fields two-columns">
          <label class="wide"><span>{{localize "PF2E_MARKET_FORGE.Profiles.Name"}}</span><input type="text" value="{{draft.name}}" data-profile-field="name" /></label>
          <label><span>{{localize "PF2E_MARKET_FORGE.Profiles.LevelMode"}}</span>
            <select data-profile-field="availability.levelLimit.mode">
              {{#each levelModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
          <label><span>{{localize "PF2E_MARKET_FORGE.Profiles.FixedLevel"}}</span><input type="number" min="0" max="30" step="1" value="{{draft.availability.levelLimit.fixedLevel}}" data-profile-field="availability.levelLimit.fixedLevel" {{#unless draft.fixedMode}}disabled{{/unless}} /></label>
          <label><span>{{localize "PF2E_MARKET_FORGE.Profiles.LevelOffset"}}</span><input type="number" min="-20" max="20" step="1" value="{{draft.availability.levelLimit.offset}}" data-profile-field="availability.levelLimit.offset" /></label>
          <label><span>{{localize "PF2E_MARKET_FORGE.Profiles.Rounding"}}</span>
            <select data-profile-field="availability.levelLimit.rounding">
              {{#each roundingOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
          <label><span>{{localize "PF2E_MARKET_FORGE.Profiles.UnavailableDisplay"}}</span>
            <select data-profile-field="availability.unavailableDisplay">
              {{#each unavailableOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
        </div>
      </section>

      <section class="market-forge-profile-section">
        <h3>{{localize "PF2E_MARKET_FORGE.Profiles.Rarities"}}</h3>
        <div class="market-forge-checkbox-grid">
          <label><input type="checkbox" data-profile-field="availability.rarities.common" {{#if draft.availability.rarities.common}}checked{{/if}} />{{localize "PF2E_MARKET_FORGE.Rarity.common"}}</label>
          <label><input type="checkbox" data-profile-field="availability.rarities.uncommon" {{#if draft.availability.rarities.uncommon}}checked{{/if}} />{{localize "PF2E_MARKET_FORGE.Rarity.uncommon"}}</label>
          <label><input type="checkbox" data-profile-field="availability.rarities.rare" {{#if draft.availability.rarities.rare}}checked{{/if}} />{{localize "PF2E_MARKET_FORGE.Rarity.rare"}}</label>
          <label><input type="checkbox" data-profile-field="availability.rarities.unique" {{#if draft.availability.rarities.unique}}checked{{/if}} />{{localize "PF2E_MARKET_FORGE.Rarity.unique"}}</label>
        </div>
      </section>

      <section class="market-forge-profile-section">
        <h3>{{localize "PF2E_MARKET_FORGE.Profiles.Pricing"}}</h3>
        <div class="market-forge-profile-fields two-columns">
          <label><span>{{localize "PF2E_MARKET_FORGE.Profiles.BuyPercent"}}</span><input type="number" min="0" max="1000" step="1" value="{{draft.buyPercent}}" data-profile-field="pricing.buyMultiplier" /></label>
          <label><span>{{localize "PF2E_MARKET_FORGE.Profiles.SellPercent"}}</span><input type="number" min="0" max="1000" step="1" value="{{draft.sellPercent}}" data-profile-field="pricing.sellMultiplier" /></label>
        </div>
        <div class="market-forge-checkbox-grid">
          <label><input type="checkbox" data-profile-field="pricing.fullValueTreasure.artObjects" {{#if draft.pricing.fullValueTreasure.artObjects}}checked{{/if}} />{{localize "PF2E_MARKET_FORGE.Profiles.FullValueArt"}}</label>
          <label><input type="checkbox" data-profile-field="pricing.fullValueTreasure.gems" {{#if draft.pricing.fullValueTreasure.gems}}checked{{/if}} />{{localize "PF2E_MARKET_FORGE.Profiles.FullValueGems"}}</label>
          <label><input type="checkbox" data-profile-field="pricing.fullValueTreasure.materials" {{#if draft.pricing.fullValueTreasure.materials}}checked{{/if}} />{{localize "PF2E_MARKET_FORGE.Profiles.FullValueMaterials"}}</label>
        </div>
      </section>

      <section class="market-forge-profile-section">
        <h3>{{localize "PF2E_MARKET_FORGE.Profiles.SpellItems"}}</h3>
        <div class="market-forge-checkbox-grid">
          <label><input type="checkbox" data-profile-field="spellItems.scrolls" {{#if draft.spellItems.scrolls}}checked{{/if}} />{{localize "PF2E_MARKET_FORGE.Spells.Scroll"}}</label>
          <label><input type="checkbox" data-profile-field="spellItems.wands" {{#if draft.spellItems.wands}}checked{{/if}} />{{localize "PF2E_MARKET_FORGE.Spells.Wand"}}</label>
        </div>
      </section>

      <section class="market-forge-profile-section">
        <h3>{{localize "PF2E_MARKET_FORGE.Profiles.ItemSources"}}</h3>
        <p class="notes">{{localize "PF2E_MARKET_FORGE.Profiles.SourceHint"}}</p>
        <div class="market-forge-compendium-grid">
          {{#each itemCompendia}}
            <label><input type="checkbox" value="{{id}}" data-profile-source="itemCompendia" {{#if selected}}checked{{/if}} /><span><strong>{{label}}</strong><small>{{id}}</small></span></label>
          {{/each}}
        </div>
      </section>

      <section class="market-forge-profile-section">
        <h3>{{localize "PF2E_MARKET_FORGE.Profiles.SpellSources"}}</h3>
        <p class="notes">{{localize "PF2E_MARKET_FORGE.Profiles.SourceHint"}}</p>
        <div class="market-forge-compendium-grid">
          {{#each spellCompendia}}
            <label><input type="checkbox" value="{{id}}" data-profile-source="spellCompendia" {{#if selected}}checked{{/if}} /><span><strong>{{label}}</strong><small>{{id}}</small></span></label>
          {{/each}}
        </div>
      </section>
    </main>
  </div>

  <footer class="market-forge-profile-footer">
    <div>
      {{#if dirty}}<span class="market-forge-unsaved"><i class="fa-solid fa-circle"></i>{{localize "PF2E_MARKET_FORGE.Profiles.Unsaved"}}</span>{{/if}}
      {{#unless valid}}<span class="market-forge-warning-inline">{{localize "PF2E_MARKET_FORGE.Profiles.Invalid"}}</span>{{/unless}}
    </div>
    <div class="market-forge-profile-editor-actions">
      <button type="button" data-profile-reset {{#unless dirty}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i>{{localize "PF2E_MARKET_FORGE.Profiles.Reset"}}</button>
      <button type="button" data-profile-save><i class="fa-solid fa-floppy-disk"></i>{{localize "PF2E_MARKET_FORGE.Profiles.Save"}}</button>
    </div>
  </footer>
</div>
