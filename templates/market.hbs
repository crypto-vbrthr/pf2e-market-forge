<div class="market-forge-shell">
  <header class="market-forge-hero">
    {{#if actor}}
      <img class="market-forge-actor-image" src="{{actor.img}}" alt="{{actor.name}}" />
      <div class="market-forge-actor-details">
        <h2>{{actor.name}}</h2>
        <div class="market-forge-meta">
          <span><i class="fa-solid fa-user-tag"></i> {{actor.typeLabel}}</span>
          <span><i class="fa-solid fa-coins"></i> {{actor.currency}}</span>
        </div>
      </div>
    {{/if}}
    <div class="market-forge-profile-summary">
      <span class="market-forge-kicker">{{localize "PF2E_MARKET_FORGE.MarketProfile"}}</span>
      <strong>{{profile.name}}</strong>
      <small>{{profile.levelMode}}{{#if profile.offset}} · {{localize "PF2E_MARKET_FORGE.Offset"}} {{profile.offset}}{{/if}}</small>
      <small>{{localize "PF2E_MARKET_FORGE.MaximumItemLevel"}}: {{profile.maximumItemLevelLabel}}</small>
    </div>
  </header>

  <nav class="market-forge-tabs" aria-label="{{localize "PF2E_MARKET_FORGE.Navigation"}}">
    <button type="button" class="{{#if buyTab.active}}active{{/if}}" data-market-tab="buy">
      <i class="fa-solid fa-basket-shopping"></i>{{localize "PF2E_MARKET_FORGE.Tabs.Buy"}}
    </button>
    <button type="button" class="{{#if spellItemsTab.active}}active{{/if}}" data-market-tab="spell-items">
      <i class="fa-solid fa-scroll"></i>{{localize "PF2E_MARKET_FORGE.Tabs.SpellItems"}}
    </button>
    <button type="button" class="{{#if sellTab.active}}active{{/if}}" data-market-tab="sell">
      <i class="fa-solid fa-hand-holding-dollar"></i>{{localize "PF2E_MARKET_FORGE.Tabs.Sell"}}
    </button>
    <button type="button" class="{{#if cartTab.active}}active{{/if}}" data-market-tab="cart">
      <i class="fa-solid fa-cart-shopping"></i>{{localize "PF2E_MARKET_FORGE.Tabs.Cart"}}
      <span class="market-forge-badge">{{cart.count}}</span>
    </button>
  </nav>

  <main class="market-forge-content">
    {{#if buyTab.active}}
      <section class="market-forge-panel market-forge-buy-panel">
        <div class="market-forge-toolbar market-forge-catalog-toolbar">
          <label class="market-forge-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" value="{{catalogFilters.search}}" data-catalog-filter="search" placeholder="{{localize "PF2E_MARKET_FORGE.Buy.SearchPlaceholder"}}" />
          </label>
          <select data-catalog-filter="category" aria-label="{{localize "PF2E_MARKET_FORGE.Buy.Category"}}">
            <option value="all">{{localize "PF2E_MARKET_FORGE.Buy.AllCategories"}}</option>
            {{#each catalogOptions.categories}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <select data-catalog-filter="level" aria-label="{{localize "PF2E_MARKET_FORGE.Buy.Level"}}">
            <option value="all">{{localize "PF2E_MARKET_FORGE.Buy.AllLevels"}}</option>
            {{#each catalogOptions.levels}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <select data-catalog-filter="rarity" aria-label="{{localize "PF2E_MARKET_FORGE.Buy.Rarity"}}">
            <option value="all">{{localize "PF2E_MARKET_FORGE.Buy.AllRarities"}}</option>
            {{#each catalogOptions.rarities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <select data-catalog-filter="sourcePack" aria-label="{{localize "PF2E_MARKET_FORGE.Buy.Compendium"}}">
            <option value="all">{{localize "PF2E_MARKET_FORGE.Buy.AllCompendia"}}</option>
            {{#each catalogOptions.sources}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>

        <div class="market-forge-catalog-summary">
          <span><i class="fa-solid fa-list"></i> {{catalog.resultLabel}}</span>
          <span><i class="fa-solid fa-gauge-high"></i> {{localize "PF2E_MARKET_FORGE.MaximumItemLevel"}}: {{profile.maximumItemLevelLabel}}</span>
        </div>

        {{#each catalog.sourceWarnings}}
          <div class="market-forge-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{label}}: {{error}}</div>
        {{/each}}

        {{#if catalog.hasEntries}}
          <div class="market-forge-catalog-list">
            {{#each catalog.entries}}
              <article class="market-forge-item-row {{#unless available}}unavailable{{/unless}}">
                <div class="market-forge-item-main">
                  <button type="button" class="market-forge-expand-button" data-market-expand-item="{{uuid}}" title="{{localize "PF2E_MARKET_FORGE.Buy.ToggleDetails"}}">
                    <i class="fa-solid {{#if expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
                  </button>
                  <img src="{{img}}" alt="{{name}}" class="market-forge-item-image" />
                  <div class="market-forge-item-identity">
                    <strong>{{name}}</strong>
                    <small>{{typeLabel}} · {{rarityLabel}} · {{sourceLabel}}</small>
                    {{#unless available}}<small class="market-forge-unavailable-reason"><i class="fa-solid fa-lock"></i> {{availabilityReasonText}}</small>{{/unless}}
                  </div>
                  <div class="market-forge-item-level"><span>{{localize "PF2E_MARKET_FORGE.ItemLevel"}}</span><strong>{{level}}</strong></div>
                  <div class="market-forge-item-price"><span>{{localize "PF2E_MARKET_FORGE.Price"}}</span><strong>{{priceLabel}}</strong></div>
                  <div class="market-forge-buy-controls">
                    <input type="number" min="1" max="999" step="1" value="1" data-market-quantity="{{uuid}}" aria-label="{{localize "PF2E_MARKET_FORGE.Quantity"}}" {{#unless available}}disabled{{/unless}} />
                    <button type="button" class="market-forge-cart-button" data-market-add-item="{{uuid}}" {{#unless available}}disabled{{/unless}}>
                      <i class="fa-solid fa-cart-plus"></i>{{localize "PF2E_MARKET_FORGE.AddToCart"}}
                    </button>
                  </div>
                </div>

                {{#if expanded}}
                  <div class="market-forge-item-preview">
                    {{#if preview}}
                      {{#if preview.traitLabels.length}}<div class="market-forge-traits">{{#each preview.traitLabels}}<span>{{this}}</span>{{/each}}</div>{{/if}}
                      <div class="market-forge-preview-meta">
                        {{#if preview.usage}}<span><b>{{localize "PF2E_MARKET_FORGE.Preview.Usage"}}:</b> {{preview.usage}}</span>{{/if}}
                        {{#if preview.bulk}}<span><b>{{localize "PF2E_MARKET_FORGE.Preview.Bulk"}}:</b> {{preview.bulk}}</span>{{/if}}
                        {{#if preview.sourceLabel}}<span><b>{{localize "PF2E_MARKET_FORGE.Preview.Source"}}:</b> {{preview.sourceLabel}}</span>{{/if}}
                      </div>
                      <div class="market-forge-description">{{{preview.renderedDescription}}}</div>
                      <div class="market-forge-preview-actions"><button type="button" data-market-open-item="{{uuid}}"><i class="fa-solid fa-up-right-from-square"></i>{{localize "PF2E_MARKET_FORGE.Buy.OpenItemSheet"}}</button></div>
                    {{else}}
                      {{#if previewError}}
                        <div class="market-forge-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{previewError}}</div>
                      {{else}}
                        <div class="market-forge-preview-loading"><i class="fa-solid fa-spinner fa-spin"></i> {{localize "PF2E_MARKET_FORGE.Buy.LoadingDetails"}}</div>
                      {{/if}}
                    {{/if}}
                  </div>
                {{/if}}
              </article>
            {{/each}}
          </div>
        {{else}}
          <div class="market-forge-empty-state"><i class="fa-solid fa-box-open"></i><h3>{{localize "PF2E_MARKET_FORGE.Buy.NoResultsTitle"}}</h3><p>{{localize "PF2E_MARKET_FORGE.Buy.NoResultsText"}}</p></div>
        {{/if}}
      </section>
    {{/if}}

    {{#if spellItemsTab.active}}
      <section class="market-forge-panel market-forge-spell-builder">
        <div class="market-forge-toolbar market-forge-spell-toolbar">
          <label class="market-forge-search">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            <input type="search" value="{{spellFilters.search}}" data-spell-filter="search" placeholder="{{localize "PF2E_MARKET_FORGE.Spells.SearchPlaceholder"}}" />
          </label>
          <select data-spell-filter="baseRank" aria-label="{{localize "PF2E_MARKET_FORGE.Spells.BaseRank"}}">
            <option value="all">{{localize "PF2E_MARKET_FORGE.Spells.AllRanks"}}</option>
            {{#each spellOptions.ranks}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <select data-spell-filter="tradition" aria-label="{{localize "PF2E_MARKET_FORGE.Spells.Tradition"}}">
            <option value="all">{{localize "PF2E_MARKET_FORGE.Spells.AllTraditions"}}</option>
            {{#each spellOptions.traditions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <select data-spell-filter="rarity" aria-label="{{localize "PF2E_MARKET_FORGE.Buy.Rarity"}}">
            <option value="all">{{localize "PF2E_MARKET_FORGE.Buy.AllRarities"}}</option>
            {{#each spellOptions.rarities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <select data-spell-filter="sourcePack" aria-label="{{localize "PF2E_MARKET_FORGE.Buy.Compendium"}}">
            <option value="all">{{localize "PF2E_MARKET_FORGE.Buy.AllCompendia"}}</option>
            {{#each spellOptions.sources}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>

        <div class="market-forge-catalog-summary">
          <span><i class="fa-solid fa-book"></i> {{spellCatalog.resultLabel}}</span>
          <span><i class="fa-solid fa-gauge-high"></i> {{localize "PF2E_MARKET_FORGE.MaximumItemLevel"}}: {{profile.maximumItemLevelLabel}}</span>
        </div>

        {{#each spellCatalog.sourceWarnings}}
          <div class="market-forge-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{label}}: {{error}}</div>
        {{/each}}

        <div class="market-forge-spell-layout">
          <div class="market-forge-spell-list">
            {{#if spellCatalog.hasEntries}}
              {{#each spellCatalog.entries}}
                <button type="button" class="market-forge-spell-row {{#if selected}}selected{{/if}} {{#unless availability.available}}unavailable{{/unless}}" data-spell-select="{{uuid}}">
                  <img src="{{img}}" alt="{{name}}" />
                  <span class="market-forge-spell-identity">
                    <strong>{{name}}</strong>
                    <small>{{localize "PF2E_MARKET_FORGE.Spells.BaseRank"}} {{baseRank}} · {{traditionsText}}</small>
                    <small>{{rarityLabel}} · {{sourceLabel}}</small>
                  </span>
                  <span class="market-forge-spell-rank">{{baseRank}}</span>
                </button>
              {{/each}}
            {{else}}
              <div class="market-forge-empty-state compact"><i class="fa-solid fa-book-open"></i><h3>{{localize "PF2E_MARKET_FORGE.Spells.EmptyTitle"}}</h3><p>{{localize "PF2E_MARKET_FORGE.Spells.EmptyText"}}</p></div>
            {{/if}}
          </div>

          <aside class="market-forge-config-card market-forge-spell-config">
            {{#if spellBuilder}}
              <div class="market-forge-spell-selected">
                <img src="{{spellBuilder.spell.img}}" alt="{{spellBuilder.spell.name}}" />
                <div>
                  <h3>{{spellBuilder.spell.name}}</h3>
                  <small>{{localize "PF2E_MARKET_FORGE.Spells.BaseRank"}} {{spellBuilder.spell.baseRank}} · {{spellBuilder.spell.traditionsText}}</small>
                  <small>{{spellBuilder.spell.rarityLabel}} · {{spellBuilder.spell.sourceLabel}}</small>
                </div>
              </div>

              <label>{{localize "PF2E_MARKET_FORGE.Spells.Type"}}
                <select data-spell-kind>
                  {{#each spellBuilder.kindOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}
                </select>
              </label>
              <label>{{localize "PF2E_MARKET_FORGE.Spells.Rank"}}
                <select data-spell-rank>
                  {{#each spellBuilder.rankOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}
                </select>
              </label>
              <label>{{localize "PF2E_MARKET_FORGE.Quantity"}}
                <input type="number" min="1" max="999" step="1" value="{{spellBuilder.quantity}}" data-spell-quantity />
              </label>

              <div class="market-forge-spell-product-name"><strong>{{spellBuilder.productName}}</strong></div>
              <div class="market-forge-price-preview market-forge-spell-price-preview">
                <span>{{localize "PF2E_MARKET_FORGE.ItemLevel"}}: <strong>{{spellBuilder.itemLevel}}</strong></span>
                <span>{{localize "PF2E_MARKET_FORGE.Price"}}: <strong>{{spellBuilder.priceLabel}}</strong></span>
                <span>{{localize "PF2E_MARKET_FORGE.Cart.Total"}}: <strong>{{spellBuilder.totalPriceLabel}}</strong></span>
              </div>

              {{#unless spellBuilder.available}}
                <div class="market-forge-warning"><i class="fa-solid fa-lock"></i> {{spellBuilder.availabilityReasonText}}</div>
              {{/unless}}

              <div class="market-forge-spell-description">
                {{#if spellBuilder.preview}}
                  {{#if spellBuilder.preview.traitLabels.length}}<div class="market-forge-traits">{{#each spellBuilder.preview.traitLabels}}<span>{{this}}</span>{{/each}}</div>{{/if}}
                  <div class="market-forge-preview-meta">
                    <span><b>{{localize "PF2E_MARKET_FORGE.Spells.SelectedRank"}}:</b> {{spellBuilder.castRank}}</span>
                    {{#if spellBuilder.preview.traditionLabels.length}}<span><b>{{localize "PF2E_MARKET_FORGE.Spells.Tradition"}}:</b> {{#each spellBuilder.preview.traditionLabels}}{{#unless @first}}, {{/unless}}{{this}}{{/each}}</span>{{/if}}
                  </div>
                  <div class="market-forge-description">{{{spellBuilder.preview.renderedDescription}}}</div>
                  <div class="market-forge-preview-actions"><button type="button" data-spell-open="{{spellBuilder.spell.uuid}}"><i class="fa-solid fa-up-right-from-square"></i>{{localize "PF2E_MARKET_FORGE.Spells.OpenSpell"}}</button></div>
                {{else}}
                  {{#if spellBuilder.previewError}}
                    <div class="market-forge-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{spellBuilder.previewError}}</div>
                  {{else}}
                    <div class="market-forge-preview-loading"><i class="fa-solid fa-spinner fa-spin"></i> {{localize "PF2E_MARKET_FORGE.Spells.LoadingPreview"}}</div>
                  {{/if}}
                {{/if}}
              </div>

              <button type="button" class="market-forge-cart-button" data-spell-add-cart {{#unless spellBuilder.available}}disabled{{/unless}}>
                <i class="fa-solid fa-cart-plus"></i>{{localize "PF2E_MARKET_FORGE.AddToCart"}}
              </button>
            {{else}}
              <div class="market-forge-empty-state compact"><i class="fa-solid fa-wand-magic-sparkles"></i><h3>{{localize "PF2E_MARKET_FORGE.Spells.ConfigTitle"}}</h3><p>{{localize "PF2E_MARKET_FORGE.Spells.SelectHint"}}</p></div>
            {{/if}}
          </aside>
        </div>
      </section>
    {{/if}}

    {{#if sellTab.active}}
      <section class="market-forge-panel market-forge-sell-panel">
        <div class="market-forge-section-heading">
          <div><h3>{{localize "PF2E_MARKET_FORGE.Sell.Title"}}</h3><p>{{localize "PF2E_MARKET_FORGE.Sell.TextM5"}}</p></div>
          <span class="market-forge-count"><i class="fa-solid fa-backpack"></i> {{saleInventory.sellableCount}} / {{saleInventory.count}}</span>
        </div>
        <div class="market-forge-catalog-summary">
          <span><i class="fa-solid fa-percent"></i> {{localize "PF2E_MARKET_FORGE.Sell.StandardRule"}}</span>
          <span><i class="fa-solid fa-gem"></i> {{localize "PF2E_MARKET_FORGE.Sell.FullValueRule"}}</span>
        </div>

        {{#if saleInventory.hasEntries}}
          <div class="market-forge-catalog-list market-forge-sale-list">
            {{#each saleInventory.entries}}
              <article class="market-forge-item-row {{#unless available}}unavailable{{/unless}}">
                <div class="market-forge-item-main">
                  <button type="button" class="market-forge-expand-button" data-market-expand-item="{{uuid}}" title="{{localize "PF2E_MARKET_FORGE.Buy.ToggleDetails"}}">
                    <i class="fa-solid {{#if expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
                  </button>
                  <img src="{{img}}" alt="{{name}}" class="market-forge-item-image" />
                  <div class="market-forge-item-identity">
                    <strong>{{name}}</strong>
                    <small>{{typeLabel}} · {{rarityLabel}} · {{localize "PF2E_MARKET_FORGE.Quantity"}} {{quantity}}</small>
                    {{#unless available}}<small class="market-forge-unavailable-reason"><i class="fa-solid fa-lock"></i> {{availabilityReasonText}}</small>{{/unless}}
                  </div>
                  <div class="market-forge-item-level"><span>{{localize "PF2E_MARKET_FORGE.ItemLevel"}}</span><strong>{{level}}</strong></div>
                  <div class="market-forge-item-price"><span>{{localize "PF2E_MARKET_FORGE.Sell.SalePrice"}}</span><strong>{{priceLabel}}</strong><small>{{ruleLabel}}</small></div>
                  <div class="market-forge-buy-controls">
                    <input type="number" min="1" max="{{quantity}}" step="1" value="1" data-market-sale-quantity="{{uuid}}" aria-label="{{localize "PF2E_MARKET_FORGE.Quantity"}}" {{#unless available}}disabled{{/unless}} />
                    <button type="button" class="market-forge-cart-button" data-market-add-sale="{{uuid}}" {{#unless available}}disabled{{/unless}}>
                      <i class="fa-solid fa-tags"></i>{{localize "PF2E_MARKET_FORGE.Sell.AddToSaleCart"}}
                    </button>
                  </div>
                </div>

                {{#if expanded}}
                  <div class="market-forge-item-preview">
                    {{#if preview}}
                      {{#if preview.traitLabels.length}}<div class="market-forge-traits">{{#each preview.traitLabels}}<span>{{this}}</span>{{/each}}</div>{{/if}}
                      <div class="market-forge-preview-meta">
                        <span><b>{{localize "PF2E_MARKET_FORGE.Sell.BaseValue"}}:</b> {{basePriceLabel}}</span>
                        <span><b>{{localize "PF2E_MARKET_FORGE.Sell.SalePrice"}}:</b> {{priceLabel}}</span>
                        {{#if preview.usage}}<span><b>{{localize "PF2E_MARKET_FORGE.Preview.Usage"}}:</b> {{preview.usage}}</span>{{/if}}
                        {{#if preview.bulk}}<span><b>{{localize "PF2E_MARKET_FORGE.Preview.Bulk"}}:</b> {{preview.bulk}}</span>{{/if}}
                      </div>
                      <div class="market-forge-description">{{{preview.renderedDescription}}}</div>
                      <div class="market-forge-preview-actions"><button type="button" data-market-open-item="{{uuid}}"><i class="fa-solid fa-up-right-from-square"></i>{{localize "PF2E_MARKET_FORGE.Buy.OpenItemSheet"}}</button></div>
                    {{else}}
                      {{#if previewError}}
                        <div class="market-forge-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{previewError}}</div>
                      {{else}}
                        <div class="market-forge-preview-loading"><i class="fa-solid fa-spinner fa-spin"></i> {{localize "PF2E_MARKET_FORGE.Buy.LoadingDetails"}}</div>
                      {{/if}}
                    {{/if}}
                  </div>
                {{/if}}
              </article>
            {{/each}}
          </div>
        {{else}}
          <div class="market-forge-empty-state compact"><i class="fa-solid fa-tags"></i><h3>{{localize "PF2E_MARKET_FORGE.Sell.EmptyTitle"}}</h3><p>{{localize "PF2E_MARKET_FORGE.Sell.EmptyText"}}</p></div>
        {{/if}}
      </section>
    {{/if}}

    {{#if cartTab.active}}
      <section class="market-forge-panel market-forge-cart-panel">
        <div class="market-forge-section-heading">
          <div>
            <h3>{{localize "PF2E_MARKET_FORGE.Cart.Title"}}</h3>
            <p>{{#if cart.isSell}}{{localize "PF2E_MARKET_FORGE.Sell.CartText"}}{{else}}{{localize "PF2E_MARKET_FORGE.Cart.TextM4"}}{{/if}}</p>
          </div>
          <strong class="market-forge-total">{{cart.quotedTotalLabel}}</strong>
        </div>

        <div class="market-forge-cart-direction">
          <button type="button" class="{{#if cart.isBuy}}active{{/if}}" data-cart-direction="buy"><i class="fa-solid fa-basket-shopping"></i> {{localize "PF2E_MARKET_FORGE.Tabs.Buy"}} <span class="market-forge-badge">{{cart.buyCount}}</span></button>
          <button type="button" class="{{#if cart.isSell}}active{{/if}}" data-cart-direction="sell"><i class="fa-solid fa-hand-holding-dollar"></i> {{localize "PF2E_MARKET_FORGE.Tabs.Sell"}} <span class="market-forge-badge">{{cart.sellCount}}</span></button>
        </div>

        {{#if cart.hasLines}}
          <div class="market-forge-cart-layout">
            <div class="market-forge-cart-lines">
              {{#each cart.lines}}
                <article class="market-forge-cart-line">
                  <div class="market-forge-cart-line-main">
                    {{#if isSpell}}
                      <button type="button" class="market-forge-expand-button" data-market-expand-spell="{{product.spellUuid}}" data-spell-rank="{{product.spellRank}}"><i class="fa-solid {{#if expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i></button>
                    {{else}}
                      <button type="button" class="market-forge-expand-button" data-market-expand-item="{{previewUuid}}"><i class="fa-solid {{#if expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i></button>
                    {{/if}}
                    <img src="{{product.img}}" alt="{{product.name}}" class="market-forge-item-image" />
                    <div class="market-forge-item-identity"><strong>{{product.name}}</strong><small>{{localize "PF2E_MARKET_FORGE.ItemLevel"}} {{product.level}} · {{unitPriceLabel}} {{localize "PF2E_MARKET_FORGE.Cart.PerItem"}}</small></div>
                    <div class="market-forge-quantity-stepper">
                      <button type="button" data-cart-adjust-line="{{id}}" data-cart-direction="{{direction}}" data-delta="-1"><i class="fa-solid fa-minus"></i></button>
                      <input type="number" min="1" max="{{maxQuantity}}" value="{{quantity}}" data-cart-quantity-line="{{id}}" data-cart-direction="{{direction}}" aria-label="{{localize "PF2E_MARKET_FORGE.Quantity"}}" />
                      <button type="button" data-cart-adjust-line="{{id}}" data-cart-direction="{{direction}}" data-delta="1"><i class="fa-solid fa-plus"></i></button>
                    </div>
                    <strong class="market-forge-line-total">{{totalPriceLabel}}</strong>
                    <button type="button" class="market-forge-icon-button" data-cart-remove-line="{{id}}" data-cart-direction="{{direction}}" title="{{localize "PF2E_MARKET_FORGE.Cart.Remove"}}"><i class="fa-solid fa-trash"></i></button>
                  </div>
                  {{#if expanded}}
                    <div class="market-forge-item-preview market-forge-cart-preview">
                      {{#if preview}}
                        {{#if preview.traitLabels.length}}<div class="market-forge-traits">{{#each preview.traitLabels}}<span>{{this}}</span>{{/each}}</div>{{/if}}
                        <div class="market-forge-description">{{{preview.renderedDescription}}}</div>
                        <div class="market-forge-preview-actions">
                          {{#if isSpell}}
                            <button type="button" data-market-open-spell="{{product.spellUuid}}"><i class="fa-solid fa-up-right-from-square"></i>{{localize "PF2E_MARKET_FORGE.Spells.OpenSpell"}}</button>
                          {{else}}
                            <button type="button" data-market-open-item="{{previewUuid}}"><i class="fa-solid fa-up-right-from-square"></i>{{localize "PF2E_MARKET_FORGE.Buy.OpenItemSheet"}}</button>
                          {{/if}}
                        </div>
                      {{else}}
                        {{#if previewError}}
                          <div class="market-forge-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{previewError}}</div>
                        {{else}}
                          <div class="market-forge-preview-loading"><i class="fa-solid fa-spinner fa-spin"></i> {{localize "PF2E_MARKET_FORGE.Buy.LoadingDetails"}}</div>
                        {{/if}}
                      {{/if}}
                    </div>
                  {{/if}}
                </article>
              {{/each}}
              <div class="market-forge-cart-actions"><button type="button" data-cart-clear><i class="fa-solid fa-broom"></i>{{localize "PF2E_MARKET_FORGE.Cart.Clear"}}</button></div>
            </div>

            <aside class="market-forge-checkout-card">
              <h3>{{#if cart.isSell}}{{localize "PF2E_MARKET_FORGE.Sell.CheckoutTitle"}}{{else}}{{localize "PF2E_MARKET_FORGE.Cart.CheckoutTitle"}}{{/if}}</h3>
              <dl>
                {{#if cart.isSell}}
                  <div><dt>{{localize "PF2E_MARKET_FORGE.Sell.ItemSource"}}</dt><dd>{{cart.itemActorName}}</dd></div>
                  <div><dt>{{localize "PF2E_MARKET_FORGE.Sell.ProceedsTarget"}}</dt><dd>{{cart.currencyActorName}}</dd></div>
                  <div><dt>{{localize "PF2E_MARKET_FORGE.Sell.CurrentBalance"}}</dt><dd>{{cart.balanceLabel}}</dd></div>
                  <div><dt>{{localize "PF2E_MARKET_FORGE.Sell.TotalProceeds"}}</dt><dd><strong>{{cart.quotedTotalLabel}}</strong></dd></div>
                  <div><dt>{{localize "PF2E_MARKET_FORGE.Sell.BalanceAfter"}}</dt><dd>{{cart.remainingLabel}}</dd></div>
                {{else}}
                  <div><dt>{{localize "PF2E_MARKET_FORGE.Cart.Recipient"}}</dt><dd>{{cart.itemActorName}}</dd></div>
                  <div><dt>{{localize "PF2E_MARKET_FORGE.Cart.PaymentSource"}}</dt><dd>{{cart.currencyActorName}}</dd></div>
                  <div><dt>{{localize "PF2E_MARKET_FORGE.Cart.Available"}}</dt><dd>{{cart.balanceLabel}}</dd></div>
                  <div><dt>{{localize "PF2E_MARKET_FORGE.Cart.Total"}}</dt><dd><strong>{{cart.quotedTotalLabel}}</strong></dd></div>
                  {{#if cart.affordable}}<div><dt>{{localize "PF2E_MARKET_FORGE.Cart.Remaining"}}</dt><dd>{{cart.remainingLabel}}</dd></div>{{else}}<div class="market-forge-deficit"><dt>{{localize "PF2E_MARKET_FORGE.Cart.Missing"}}</dt><dd>{{cart.deficitLabel}}</dd></div>{{/if}}
                {{/if}}
              </dl>
              {{#if cart.isBuy}}{{#unless cart.affordable}}<div class="market-forge-warning"><i class="fa-solid fa-coins"></i>{{localize "PF2E_MARKET_FORGE.Cart.InsufficientFunds"}}</div>{{/unless}}{{/if}}
              <div class="market-forge-checkout-actions">
                {{#if cart.isSell}}
                  <button type="button" class="market-forge-dry-run" data-market-dry-run {{#unless cart.canDryRun}}disabled{{/unless}}><i class="fa-solid fa-clipboard-check"></i>{{localize "PF2E_MARKET_FORGE.Sell.ValidateCheckout"}}</button>
                  <button type="button" class="market-forge-purchase" data-market-checkout {{#unless cart.canCheckout}}disabled{{/unless}}><i class="fa-solid fa-hand-holding-dollar"></i>{{localize "PF2E_MARKET_FORGE.Sell.CompleteSale"}}</button>
                {{else}}
                  <button type="button" class="market-forge-dry-run" data-market-dry-run {{#unless cart.canDryRun}}disabled{{/unless}}><i class="fa-solid fa-clipboard-check"></i>{{localize "PF2E_MARKET_FORGE.Cart.ValidateCheckout"}}</button>
                  <button type="button" class="market-forge-purchase" data-market-checkout {{#unless cart.canCheckout}}disabled{{/unless}}><i class="fa-solid fa-coins"></i>{{localize "PF2E_MARKET_FORGE.Cart.CompletePurchase"}}</button>
                {{/if}}
              </div>
              <small>{{#if cart.isSell}}{{localize "PF2E_MARKET_FORGE.Sell.CheckoutHint"}}{{else}}{{localize "PF2E_MARKET_FORGE.Cart.CheckoutHintM4"}}{{/if}}</small>

              {{#if checkout}}
                <div class="market-forge-checkout-result {{checkout.status}}">
                  {{#if checkout.isSell}}
                    {{#if checkout.valid}}<strong><i class="fa-solid fa-circle-check"></i> {{localize "PF2E_MARKET_FORGE.Sell.ValidationSuccess"}}</strong>{{/if}}
                    {{#if checkout.invalid}}<strong><i class="fa-solid fa-circle-xmark"></i> {{localize "PF2E_MARKET_FORGE.Sell.ValidationFailed"}}</strong>{{/if}}
                    {{#if checkout.error}}<strong><i class="fa-solid fa-triangle-exclamation"></i> {{localize "PF2E_MARKET_FORGE.Sell.ValidationError"}}</strong>{{/if}}
                    {{#if checkout.running}}<strong><i class="fa-solid fa-spinner fa-spin"></i> {{localize "PF2E_MARKET_FORGE.Sell.Running"}}</strong>{{/if}}
                    {{#if checkout.completed}}<strong><i class="fa-solid fa-hand-holding-dollar"></i> {{localize "PF2E_MARKET_FORGE.Sell.Completed"}}</strong>{{/if}}
                    {{#if checkout.rolledBack}}<strong><i class="fa-solid fa-rotate-left"></i> {{localize "PF2E_MARKET_FORGE.Sell.RolledBack"}}</strong>{{/if}}
                    {{#if checkout.rollbackFailed}}<strong><i class="fa-solid fa-triangle-exclamation"></i> {{localize "PF2E_MARKET_FORGE.Cart.RollbackFailed"}}</strong>{{/if}}
                    <span>{{localize "PF2E_MARKET_FORGE.Sell.AuthoritativeProceeds"}}: {{checkout.totalLabel}}</span>
                    {{#if checkout.remainingLabel}}<span>{{localize "PF2E_MARKET_FORGE.Sell.BalanceAfter"}}: {{checkout.remainingLabel}}</span>{{/if}}
                  {{else}}
                    {{#if checkout.valid}}<strong><i class="fa-solid fa-circle-check"></i> {{localize "PF2E_MARKET_FORGE.Cart.ValidationSuccess"}}</strong>{{/if}}
                    {{#if checkout.invalid}}<strong><i class="fa-solid fa-circle-xmark"></i> {{localize "PF2E_MARKET_FORGE.Cart.ValidationFailed"}}</strong>{{/if}}
                    {{#if checkout.error}}<strong><i class="fa-solid fa-triangle-exclamation"></i> {{localize "PF2E_MARKET_FORGE.Cart.ValidationError"}}</strong>{{/if}}
                    {{#if checkout.running}}<strong><i class="fa-solid fa-spinner fa-spin"></i> {{localize "PF2E_MARKET_FORGE.Cart.PurchaseRunning"}}</strong>{{/if}}
                    {{#if checkout.completed}}<strong><i class="fa-solid fa-bag-shopping"></i> {{localize "PF2E_MARKET_FORGE.Cart.PurchaseCompleted"}}</strong>{{/if}}
                    {{#if checkout.rolledBack}}<strong><i class="fa-solid fa-rotate-left"></i> {{localize "PF2E_MARKET_FORGE.Cart.PurchaseRolledBack"}}</strong>{{/if}}
                    {{#if checkout.rollbackFailed}}<strong><i class="fa-solid fa-triangle-exclamation"></i> {{localize "PF2E_MARKET_FORGE.Cart.RollbackFailed"}}</strong>{{/if}}
                    <span>{{localize "PF2E_MARKET_FORGE.Cart.AuthoritativeTotal"}}: {{checkout.totalLabel}}</span>
                    {{#if checkout.remainingLabel}}<span>{{localize "PF2E_MARKET_FORGE.Cart.Remaining"}}: {{checkout.remainingLabel}}</span>{{/if}}
                    {{#if checkout.deficitLabel}}<span>{{localize "PF2E_MARKET_FORGE.Cart.Missing"}}: {{checkout.deficitLabel}}</span>{{/if}}
                  {{/if}}
                  {{#if checkout.errorLabels.length}}<ul>{{#each checkout.errorLabels}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
                  {{#if checkout.warningLabels.length}}<ul class="market-forge-warning-list">{{#each checkout.warningLabels}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
                </div>
              {{/if}}
            </aside>
          </div>
        {{else}}
          <div class="market-forge-empty-state compact"><i class="fa-solid fa-cart-arrow-down"></i><h3>{{localize "PF2E_MARKET_FORGE.Cart.EmptyTitle"}}</h3><p>{{#if cart.isSell}}{{localize "PF2E_MARKET_FORGE.Sell.EmptyCartText"}}{{else}}{{localize "PF2E_MARKET_FORGE.Cart.EmptyTextM4"}}{{/if}}</p></div>
        {{/if}}
      </section>
    {{/if}}
  </main>

  <footer class="market-forge-footer-note"><i class="fa-solid fa-shield-halved"></i> {{localize "PF2E_MARKET_FORGE.Milestone6Footer"}}</footer>
</div>
